# ====================================================================
# NexBus backend environment template
# ====================================================================
# Copy this file to `.env` and fill in. Never commit `.env` itself —
# it contains secrets. Add `.env` to .gitignore (already excluded by
# convention; verify before your first commit).
# ====================================================================


# ── REQUIRED ───────────────────────────────────────────────────────────

# Strong random secret used to sign JWT tokens. Generate with:
#   openssl rand -hex 32
# The server refuses to start if this is missing or equal to the
# literal placeholder "change-me-in-production". In production
# (NODE_ENV=production) it must be at least 32 characters.
JWT_SECRET=

# PostgreSQL connection string for migrations and (default) runtime.
# Format: postgres://user:pass@host:port/dbname
# This connection runs as the table-owner / migration role, which has
# full DDL privileges. Used by `node migrate.js` and `node migrate-up.js`.
DATABASE_URL=


# ── REQUIRED IN PRODUCTION ─────────────────────────────────────────────

# Comma-separated list of web origins allowed via CORS. Mobile apps
# don't send Origin so they're always allowed; this only gates the
# three Flutter web flavors. Example:
#   https://nexbus.example,https://agency.nexbus.example,https://regulator.nexbus.example
# The server refuses to start in production without this. In development,
# CORS falls back to permissive with a warning.
CORS_ALLOWED_ORIGINS=

# Node environment. Set to "production" to enable the strict checks
# above. Defaults to "development".
NODE_ENV=development


# ── RECOMMENDED (RLS activation) ───────────────────────────────────────

# Runtime connection string used by the app pool. When set, the app
# connects as the unprivileged `nexbus_app` role created by migration
# 010, so Row-Level Security actually enforces tenant isolation.
# Without this, the app falls back to DATABASE_URL (owner role) which
# bypasses RLS — fine for pre-activation, not fine for production.
#
# Activation: run `node activate-rls.js` to rotate the role password
# and get a ready-to-paste APP_DATABASE_URL string.
APP_DATABASE_URL=


# ── OPTIONAL — defaults shown ──────────────────────────────────────────

# JWT lifetime. Anything `jsonwebtoken` accepts (e.g. "24h", "7d").
JWT_EXPIRES_IN=24h

# HTTP listen port.
PORT=3000

# Postgres pool sizing.
PG_POOL_MAX=50

# Per-IP rate limits, requests per minute.
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=20
RATE_LIMIT_PASSENGER_EVENTS=60

# PDF report storage. Defaults to <repo>/backend/reports. Mount a
# Railway Volume here for cross-deploy durability.
REPORTS_DIR=
